# Collecta configuration — copy to .env and fill in secrets.
# Secrets should be stored in Vaultwarden (vw.unit02.eu); .env is git-ignored.

# --- LLM (copilot-api OpenAI-compatible proxy on the LAN) ---
LLM_BASE_URL=http://192.168.0.237:4141/v1
LLM_API_KEY=dummy
LLM_MODEL=gemini-3.8-flash

# --- TMDB (reuse the key from Kometa config) ---
TMDB_API_KEY=

# --- Whisper ASR (local, GPU) ---
WHISPER_ASR_URL=http://192.168.0.237:9000

# --- Radarr (main instance) ---
RADARR_URL=http://192.168.0.237:7878
RADARR_WEB_URL=https://radarr.tokyo3.eu
RADARR_API_KEY=
RADARR_QUALITY_PROFILE=2160p Balanced
RADARR_ROOT_FOLDER=/media/Movies

# --- Kometa ---
KOMETA_CONFIG_DIR=/kometa-config
KOMETA_LIBRARY=Films

# --- Storage ---
DATA_DIR=/data

# --- Scheduled parsings: how often (seconds) to check for due schedules ---
SCHEDULER_TICK_SECONDS=60
